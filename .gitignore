# ============================================================
# Missing Boundary — Git 忽略规则
# 不纳入版本控制: 数据集、训练权重/检查点、生成图、特征缓存
# ============================================================

# ---- 大数据产物（本机运行时生成，不提交） ----
outputs/
logs/
*.log

# ---- Python 缓存 ----
__pycache__/
*.py[cod]

# ---- 训练权重 / 检查点 / 序列化对象 ----
*.pkl
*.pckl
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx

# ---- 内部工具（Claude Code agent 定义等，与实验无关） ----
.claude/

# ---- 编辑器 / 系统 ----
.DS_Store
*.swp
*~
.vscode/
.idea/
